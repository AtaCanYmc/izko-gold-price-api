# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit shell and Python script normalization
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Documentation and structured data
*.md text diff=markdown
*.json text
*.yml text
*.yaml text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary

# Release archive exclusions
.dockerignore export-ignore
.github export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.editorconfig export-ignore
.markdownlint.json export-ignore
.release-please-manifest.json export-ignore
release-please-config.json export-ignore
